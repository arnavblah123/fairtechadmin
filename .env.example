# ---- Database (Neon / any Postgres). Pooled URL for the app, direct URL for migrations.
DATABASE_URL="postgresql://user:password@localhost:5432/fairtechadmin"
DIRECT_URL="postgresql://user:password@localhost:5432/fairtechadmin"

# ---- Login cookie signing secret: `openssl rand -hex 32`
SESSION_SECRET=""

# ---- Who may log in.
# Option A: fixed owner account. Make the hash with: node -e "console.log(require('bcryptjs').hashSync('your-password', 10))"
OWNER_EMAIL="fairtechindia@gmail.com"
OWNER_NAME="Arnav"
OWNER_PASSWORD_HASH=""
# (quick start only; prefer the hash) OWNER_PASSWORD=""
# Option B (additionally): accept the Production app's SUPERADMIN login.
PRODUCTION_APP_URL="https://fairtechproduction.vercel.app"
PRODUCTION_INTEGRATION_KEY=""

# ---- The shared secret every app checks on /api/admin-feed. Same value on every app: `openssl rand -hex 32`
ADMIN_FEED_KEY=""
# Per-app override if one app uses a different key: ADMIN_FEED_KEY_PRODUCTION, ADMIN_FEED_KEY_STORE, ...

# ---- Where each app lives (can also be edited in Settings → Apps). Leave empty to hide an app.
STORE_APP_URL="https://fairtechconsumablesystem.vercel.app"
PETTY_CASH_APP_URL="https://fairtech-petty-cash.vercel.app"
MACHINES_APP_URL="https://fairtechmachines.vercel.app"
EPC_APP_URL=""
PORTAL_APP_URL="https://fairtechfamily.vercel.app"
GATE_APP_URL=""
# Purchase app is Supabase: functions base URL + anon key (gateway pass; the real auth is ADMIN_FEED_KEY)
PURCHASE_FEED_URL=""
PURCHASE_SUPABASE_ANON_KEY=""

# ---- Morning digest email (Gmail app password works)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM=""
MAIL_TO="fairtechindia@gmail.com"
APP_URL="https://owner.fairtech.in"

# ---- Protects /api/cron/* (Vercel sets the same value in the Authorization header)
CRON_SECRET=""

# ---- Local preview with sample data for all apps (never set in production)
# MOCK_FEEDS=1
