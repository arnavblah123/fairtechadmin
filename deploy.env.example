# Copy to deploy.env (gitignored), fill the <<PASTE>> lines, then run:
#   VERCEL_TOKEN=... node scripts/push-env.mjs deploy.env
# Where to get each value is in docs/DEPLOY.md.

# --- control lines (not pushed as variables)
